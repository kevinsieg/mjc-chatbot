#########################
#### Postgres credentials
#########################
POSTGRES_USER=mjc
POSTGRES_PASSWORD=mjc
POSTGRES_DB=mjcbot
DATABASE_URL=postgresql://mjc:mjc@db:5432/mjcbot

##################
###  App Variables
################## 

# Used at `next build` for rewrites (Docker: http://backend:8000). Local `next dev`: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://backend:8000

# Public URL of the frontend (widget embed). Local: http://localhost:3000 — VPS: http://162.19.241.44 (port 80 via Traefik)
NEXT_PUBLIC_WIDGET_BASE_URL=http://162.19.241.44

##################
#### AI Variables
##################
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Must match DB column `vector(N)` and Mistral embedding length (default 1024 for mistral-embed)
MISTRAL_EMBED_DIM=1024
RAG_TOP_K=5

##################
### Traefik
##################
# Rate limiting for the chat endpoint (requests per minute per IP)
TRAEFIK_RATE_LIMIT_AVERAGE=10
TRAEFIK_RATE_LIMIT_BURST=20
