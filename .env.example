#########################
#### Postgres credentials
#########################
POSTGRES_USER=mjc
POSTGRES_PASSWORD=mjc
POSTGRES_DB=mjcbot
DATABASE_URL=postgresql://mjc:mjc@db:5432/mjcbot

##################
###  App Variables
################## 

# Used at `next build` for rewrites (Docker: http://backend:8000). Local `next dev`: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://backend:8000

# Public URL of the frontend (widget embed). Local: http://localhost:3000 — VPS: http://162.19.241.44 (port 80 via Traefik)
NEXT_PUBLIC_WIDGET_BASE_URL=http://localhost:3000

##################
#### AI Variables
##################
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Must match DB column `vector(N)` and Mistral embedding length (default 1024 for mistral-embed)
MISTRAL_EMBED_DIM=1024
RAG_TOP_K=5

##################
### Traefik
##################
# Rate limiting for the chat endpoint (requests per minute per IP)
TRAEFIK_RATE_LIMIT_AVERAGE=10
TRAEFIK_RATE_LIMIT_BURST=20

# Trusted upstream IPs for X-Forwarded-For — Traefik strips XFF from untrusted peers.
# Local dev default (Docker internal ranges) is set in docker-compose.yml.
# Production (behind Cloudflare): set to Cloudflare CIDRs + loopback.
# Current Cloudflare IPv4 ranges: https://www.cloudflare.com/ips-v4
# Example production value (verify against current Cloudflare list before deploying):
# TRAEFIK_TRUSTED_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,127.0.0.1/32
